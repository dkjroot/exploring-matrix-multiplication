# Portable source files stay LF on every platform, regardless of global autocrlf.
* text=auto eol=lf
*.db -text
*.gguf -text
*.safetensors -text
*.png -text
*.jpg -text
*.ico -text
*.ttf -text
*.otf -text
# Original evidence carries byte hashes; do not normalize its captured newlines.
reports/**/*.json -text
reports/**/*.log -text
